# Owner-only prelaunch on the current production VPS and current production bot.
# Copy outside Git and fill only non-secret values. Secret values live exclusively
# in /opt/nura/secrets/production/ and are mounted by production Compose.
APP_ENV=production
PRELAUNCH_OWNER_ONLY=true
PRELAUNCH_TELEGRAM_ALLOWED_USER_IDS=
ADMIN_TELEGRAM_ID=
PAYMENTS_ENABLED=false
POSTGRES_USER=nura
POSTGRES_DB=nura
PRODUCTION_HOSTNAME=nura-ai.ru

# Current production endpoints and governed AI model.
REPORT_BASE_URL=https://nura-ai.ru
CORS_ALLOWED_ORIGINS=https://nura-ai.ru,https://www.nura-ai.ru
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
REPORT_PROMPT_BUNDLE_VERSION=v1
CHAT_PROMPT_BUNDLE_VERSION=v1

# NURA 1.5/legacy promotion surfaces stay closed during prelaunch.
ENABLE_EXPANDED_TAROT=false
ENABLE_COMPATIBILITY=false
ENABLE_REFERRAL_PROMOTION=false
ENABLE_INTERNAL_PAYMENT_SHORTCUT=false
YOOKASSA_EXPECT_TEST_MODE=false
TEST_MODE=false
SESSION_COOKIE_SECURE=true

# Container secret-file paths are assigned per service by docker-compose.yml.
# Never add *_TOKEN, *_PASSWORD, *_SECRET, DATABASE_URL or secret values here.
REDIS_URL=redis://redis:6379/0
NURA_CELERY_BROKER_URL=redis://redis:6379/1
NURA_CELERY_RESULT_BACKEND=redis://redis:6379/2

# YooKassa shop, key and receipt fields are intentionally absent while payments are off.
