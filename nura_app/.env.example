# === App ===
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string-64-chars-min

# === Database ===
POSTGRES_USER=nura
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=nura
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nura:change-me-db-password@postgres:5432/nura
DATABASE_URL_SYNC=postgresql://nura:change-me-db-password@postgres:5432/nura

# === Redis ===
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-redis-password

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Telegram ===
TELEGRAM_BOT_TOKEN=change-me-real-bot-token
BOT_USERNAME=ai_nura_bot

# === DeepSeek ===
DEEPSEEK_API_KEY=change-me-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# === YooKassa ===
YOOKASSA_SHOP_ID=change-me
YOOKASSA_SECRET_KEY=change-me
YOOKASSA_VERIFY_ON_WEBHOOK=true
# Comma-separated CIDR whitelist of YooKassa webhook source IPs. Empty = skip IP check (dev only).
# Production MUST set this. Ranges: see YooKassa docs (185.*.*.*/27 etc.)
YOOKASSA_IP_WHITELIST=

# === Report ===
REPORT_BASE_URL=https://nura-ai.ru

# === Web Push (VAPID) ===
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@nura-ai.ru
