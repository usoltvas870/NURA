# === App ===
APP_NAME=NURA
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-random-string-64-chars-min

# === Database ===
POSTGRES_USER=nura
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=nura
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nura:change-me-db-password@postgres:5432/nura
DATABASE_URL_SYNC=postgresql://nura:change-me-db-password@postgres:5432/nura

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Telegram ===
TELEGRAM_BOT_TOKEN=change-me-real-bot-token
BOT_USERNAME=ai_nura_bot
TELEGRAM_WEBHOOK_URL=https://nura-ai.ru/webhook/telegram

# === DeepSeek ===
DEEPSEEK_API_KEY=change-me-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# === YooKassa ===
YOOKASSA_SHOP_ID=change-me
YOOKASSA_SECRET_KEY=change-me
YOOKASSA_RETURN_URL=https://nura-ai.ru/report/

# === Report ===
REPORT_BASE_URL=https://nura-ai.ru
REPORT_PRICE_RUB=590

# === Rate limit ===
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# === Web Push (VAPID) ===
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@nura-ai.ru
