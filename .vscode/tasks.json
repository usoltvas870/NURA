{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NURA: Ruff",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m ruff check .",
      "options": {
        "cwd": "${workspaceFolder}/nura_app"
      },
      "problemMatcher": []
    },
    {
      "label": "NURA: Pytest",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}/nura_app"
      },
      "problemMatcher": []
    },
    {
      "label": "NURA: Verify",
      "dependsOrder": "sequence",
      "dependsOn": [
        "NURA: Ruff",
        "NURA: Pytest"
      ],
      "problemMatcher": []
    },
    {
      "label": "NURA: Docker Up",
      "type": "shell",
      "command": "docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}/nura_app"
      },
      "problemMatcher": []
    },
    {
      "label": "NURA: Docker Logs",
      "type": "shell",
      "command": "docker compose logs --tail 100",
      "options": {
        "cwd": "${workspaceFolder}/nura_app"
      },
      "problemMatcher": []
    }
  ]
}
